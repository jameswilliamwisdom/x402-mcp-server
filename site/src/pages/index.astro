---
// index.astro — Custom landing page (SITE-04)
// Full custom page — NOT Starlight template.
// Sets data-theme="dark" directly, imports global.css manually.
import '../styles/global.css';
import Hero from '../components/landing/Hero.astro';
import HowItWorks from '../components/landing/HowItWorks.astro';
import PricingSummary from '../components/landing/PricingSummary.astro';
import Footer from '../components/landing/Footer.astro';

const SITE_URL = import.meta.env.SITE || 'https://usebismuth.com';
const OG_IMAGE = `${SITE_URL}/og-image.png`;
---

<!doctype html>
<html lang="en" data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <title>Bismuth — Pay-per-use APIs for AI Agents</title>
    <meta
      name="description"
      content="Pay-per-use APIs for AI agents. No API key required — pay per call with USDC on Base."
    />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content="Bismuth — Pay-per-use APIs for AI Agents" />
    <meta
      property="og:description"
      content="Pay-per-use APIs for AI agents. No API key required — pay per call with USDC on Base."
    />
    <meta property="og:image" content={OG_IMAGE} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="Bismuth — Pay-per-use APIs for AI Agents" />
    <meta
      name="twitter:description"
      content="Pay-per-use APIs for AI agents. No API key required — pay per call with USDC on Base."
    />
    <meta name="twitter:image" content={OG_IMAGE} />

    <!-- Favicon -->
    <link rel="icon" type="image/png" href="/logo-mark.png" />

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@300;400;500;600;700&family=JetBrains+Mono:wght@300;400;500;600;700&display=swap"
    />
  </head>
  <body>
    <Hero />
    <HowItWorks />
    <PricingSummary />
    <Footer />
  </body>
</html>
